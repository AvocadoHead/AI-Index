{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Index reviewed metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records",
    "workflows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "researchId",
          "legacyName",
          "entityType",
          "vendor",
          "product",
          "name",
          "officialUrl",
          "description",
          "descriptionLanguage",
          "status",
          "verifiedAt",
          "sources",
          "modelObservations",
          "limitations",
          "uncertainties",
          "recommendation",
          "aliases",
          "capabilities",
          "identityNote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "researchId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "legacyName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "entityType": {
            "enum": [
              "vendor",
              "product",
              "model",
              "platform",
              "model-family",
              "product-family",
              "unknown",
              "product_suite",
              "workflow_platform",
              "workflow_engine",
              "code_driven_workflow"
            ]
          },
          "vendor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "product": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "officialUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "descriptionLanguage": {
            "enum": [
              "en",
              "he",
              null
            ]
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "renamed",
              "uncertain"
            ]
          },
          "verifiedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "checkedAt"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "modelObservations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "vendor",
                "observedAt",
                "note"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "vendor": {
                  "type": "string",
                  "minLength": 1
                },
                "observedAt": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendation": {
            "type": "null"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "identityNote": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "guidance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
